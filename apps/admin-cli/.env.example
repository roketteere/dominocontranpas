# Copy to .env (gitignored) and fill in.

# Convex prod deployment URL — same value as VITE_CONVEX_URL in netlify.toml.
CONVEX_URL=https://frugal-goldfish-605.convex.cloud

# Your users._id — the row where isOwner=true. Find via Convex dashboard →
# Data → users → click your row → copy the _id field. Looks like
# "j572b8h3p9..." (a long base32 string).
ADMIN_USER_ID=

# Optional. Only needed for the `set-owner` subcommand. Must match the
# OWNER_SECRET env var you set in the Convex dashboard.
OWNER_SECRET=
