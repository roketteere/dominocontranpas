# Dependencies
node_modules/
.pnpm-store/

# Build outputs
dist/
build/
.next/
.vite/
.turbo/
out/

# Convex deployment cache (large, machine-specific)
.convex/
# NOTE: apps/convex/_generated/ is COMMITTED (small, stable, needed for web bundle resolution).
# `pnpm --filter convex dev` overwrites the stubs with typed versions on first run.

# Env / secrets
.env
.env.local
.env.*.local
.env.local.*
.secrets/

# Editor / OS
.vscode/
.idea/
.DS_Store
Thumbs.db
*.swp
*.swo

# Logs / coverage
*.log
npm-debug.log*
pnpm-debug.log*
coverage/
.nyc_output/

# PWA / SW build artifacts
sw.js.map
workbox-*.js
workbox-*.js.map

